    "PublicDriver": {
      "title": "PublicDriver",
      "description": "Public non-PII driver showcase summary (never stores email or private credentials).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "usernameLower": {
          "type": "string",
          "minLength": 3,
