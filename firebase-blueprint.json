{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private authenticated user account and PII profile isolated strictly to the account owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "usernameLower": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "authProvider": {
          "type": "string",
          "enum": ["google", "firebase"]
        },
        "createdAt": {
          "type": "timestamp"
        },
        "updatedAt": {
          "type": "timestamp"
        }
      },
      "required": [
        "uid",
        "username",
        "usernameLower",
        "email",
        "displayName",
        "authProvider",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudProgress": {
