  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account documents containing email and handle metadata, readable/writable only by owner."
    },
    "/users/{userId}/cloudData/{docId}": {
      "schema": { "$ref": "#/entities/CloudProgress" },
      "description": "Owner-only cloud progress snapshot (docId='progress') synced natively across devices."
    },
    "/users/{userId}/draftMaps/{mapId}": {
      "schema": { "$ref": "#/entities/CustomMapDoc" },
      "description": "Owner-only custom map drafts saved separately to avoid exceeding 1MB document limits."
    },
    "/publicDrivers/{userId}": {
      "schema": { "$ref": "#/entities/PublicDriver" },
      "description": "Public non-PII driver showcase documents."
    },
    "/publicMaps/{mapId}": {
      "schema": { "$ref": "#/entities/CustomMapDoc" },
      "description": "Published community custom maps discoverable across devices."
    }
  }
}
